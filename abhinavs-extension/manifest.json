{
  "manifest_version": 3,
  "name": "Abhinav's extension",
  "version": "1.0.0",
  "description": "Send the sites you choose through your own proxy server.",
  "permissions": ["proxy", "storage", "webRequest", "webRequestAuthProvider", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Abhinav's extension",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/off-16.png", "32": "icons/off-32.png" }
  },
  "icons": { "16": "icons/on-16.png", "32": "icons/on-32.png", "48": "icons/on-48.png", "128": "icons/on-128.png" }
}
