# Public HTTPS address of this server (what you paste into Twilio), no trailing slash
PUBLIC_BASE_URL=https://your-server.example.com
# Long random secret; paste the same value into the iPhone app's Settings
APP_API_TOKEN=change-me-to-a-long-random-string

ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5

# Twilio console > Account > API keys & tokens > Auth Token
TWILIO_AUTH_TOKEN=
VALIDATE_TWILIO_SIGNATURE=true
TTS_VOICE=Polly.Joanna-Neural

DATABASE_PATH=/data/calls.db

# Optional push notifications (Apple Developer > Keys > APNs key, .p8 file)
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.example.CallAssistant
APNS_USE_SANDBOX=true
